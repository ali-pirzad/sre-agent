@model Booking
@{
    ViewData["Title"] = "Booking Confirmed!";
}

<div class="text-center mt-5">
    <div class="alert alert-success p-5">
        <h1>✅ Booking Confirmed!</h1>
        <hr />
        <h3>Confirmation Number: <strong>@Model.ConfirmationNumber</strong></h3>
        <div class="mt-4 text-start d-inline-block">
            <table class="table table-borderless">
                <tr><th>Passenger:</th><td>@Model.PassengerName</td></tr>
                <tr><th>Email:</th><td>@Model.Email</td></tr>
                <tr><th>Phone:</th><td>@Model.Phone</td></tr>
                <tr><th>Flight:</th><td>@Model.Flight?.FlightNumber - @Model.Flight?.Airline</td></tr>
                <tr><th>Route:</th><td>@Model.Flight?.DepartureCity → @Model.Flight?.ArrivalCity</td></tr>
                <tr><th>Departure:</th><td>@Model.Flight?.DepartureTime.ToString("MMM dd, yyyy HH:mm")</td></tr>
                <tr><th>Seats:</th><td>@Model.NumberOfSeats</td></tr>
            </table>
        </div>
        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">Browse More Flights</a>
            <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-primary btn-lg ms-2">View All Bookings</a>
        </div>
    </div>
</div>
